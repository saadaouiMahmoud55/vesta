%% C4 niveau 2 : conteneurs (VST-69). Pas de Firebase Storage (photos en base64 dans Firestore), pas de FCM dans le MVP, OpenStreetMap au lieu de Google Maps.
flowchart TB
  Buyer["<b>Acheteur / locataire / voyageur</b><br/>Peut naviguer en invité"]:::person
  Owner["<b>Propriétaire / agent</b>"]:::person
  subgraph APPS["Application mobile Vesta (deux versions)"]
    direction LR
    Flutter["<b>Application Flutter</b><br/>[Dart, Android, test interne sur Google Play]"]:::ours
    RN["<b>Application React Native</b><br/>[TypeScript, démonstration académique]"]:::ours
  end
  subgraph FB["Firebase (back-end partagé)"]
    direction LR
    Auth["<b>Firebase Auth</b><br/>[Comptes et sessions]"]:::ext
    Store["<b>Firestore</b><br/>[Annonces, photos en base64, favoris, messages]"]:::ext
  end
  OSM["<b>OpenStreetMap</b><br/>[Tuiles de la carte]"]:::ext
