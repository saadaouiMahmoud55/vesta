%% C4 niveau 1 : contexte du système (VST-69). Choix : OpenStreetMap (pas Google Maps), photos dans Firestore (pas Firebase Storage).
flowchart LR
  Buyer["<b>Acheteur / locataire / voyageur</b><br/>Navigue en invité, se connecte pour enregistrer et contacter"]:::person
  Owner["<b>Propriétaire / agent</b><br/>Publie des annonces"]:::person
  Vesta["<b>Application Vesta</b><br/>Flutter + React Native"]:::ours
  Firebase["<b>Firebase</b><br/>Authentification et base de données (photos en base64)"]:::ext
  OSM["<b>OpenStreetMap</b><br/>Tuiles de la carte"]:::ext
  Play["<b>Google Play</b><br/>Distribution de l'application"]:::ext
  Buyer -->|"Cherche des annonces, enregistre des favoris, contacte les propriétaires"| Vesta
  Owner -->|"Publie et gère des annonces"| Vesta
  Vesta -->|"Authentifie les utilisateurs, lit et écrit les données"| Firebase
  Vesta -->|"Charge les tuiles de la carte"| OSM
  Vesta -.->|"Est distribuée sur"| Play
  classDef person fill:#e3f4ec,stroke:#2a9d6f,color:#14543b
  classDef ours fill:#e8e8ff,stroke:#6a64d8,color:#2b2780
  classDef ext fill:#f1ede8,stroke:#8a8178,color:#3b3630
